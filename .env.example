# Required credentials. Never commit real values.
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
DATABASE_URL=postgresql://morningfeed:change-me@localhost:5432/morningfeed

# Safe-by-default access control. Comma-separated numeric Telegram user IDs.
ALLOWED_TELEGRAM_IDS=
ADMIN_TELEGRAM_IDS=

# Explicitly opt in only if you intend to let anyone use your OpenAI quota.
ALLOW_ALL_USERS=false

# Optional runtime settings.
OPENAI_SUMMARY_MODEL=gpt-6-luna
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_ENDPOINT=auto
OPENAI_DEBUG=false
INLINE_CMDS_ENABLED=true
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=info
